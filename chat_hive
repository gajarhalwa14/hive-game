<body>
<div class="app">
  <aside class="sidebar">
    <div class="title">
      <h1>Hive — vs Bot</h1>
      <div class="pill" id="turnPill">Your turn</div>
    </div>

    <div class="status">
      <div class="row"><div><b>You</b> (White)</div><div id="youInfo" class="small"></div></div>
      <div class="row"><div><b>Bot</b> (Black)</div><div id="botInfo" class="small"></div></div>
      <div class="row small"><div id="ruleInfo">Place your Queen by turn 4. You can’t move until your Queen is down.</div><div></div></div>
    </div>

    <div class="invWrap">
      <div class="invTitle">
        <h2>Your inventory</h2>
        <div class="hint">Click a piece → click board</div>
      </div>
