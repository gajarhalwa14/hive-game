}
function hexPoints(rad){
  const pts=[];
  for(let i=0;i<6;i++){
    const ang = (Math.PI/180)*(60*i-30);
    pts.push([rad*Math.cos(ang), rad*Math.sin(ang)]);
  }
  return pts.map(p=>p[0].toFixed(1)+","+p[1].toFixed(1)).join(" ");
}

function renderInventory(){
  invGrid.innerHTML="";
  for(const pt of PIECES){
    const cnt = state.inv[WHITE][pt];
    const btn = document.createElement("div");
    btn.className="invBtn";
    btn.dataset.pt=pt;
    btn.innerHTML = `
      <div class="invLeft">
        ${miniHexSVG("rgba(243,240,232,.98)","rgba(0,0,0,.20)", pt, "rgba(0,0,0,.78)")}
        <div class="invName">
          <span>${PIECE_NAMES[pt]}</span>
          <em>${pt==="Q"?"1 step":" "}</em>
        </div>
      </div>
      <div class="count">${cnt}</div>
    `;

    if(cnt<=0){
      btn.style.opacity = .45;
      btn.style.filter = "grayscale(.3)";
      btn.style.pointerEvents = "none";
    }

    btn.addEventListener("click", ()=>{
      if(state.turn!==WHITE) return;
      clearSelection();
      selection.invPieceType = pt;
      selection.mode="place";
      btn.classList.add("selected");
      selection.legalTargets = legalPlacementsFor(state, WHITE);
      if(mustPlaceQueenNow(state, WHITE) && pt!=="Q"){
        toast("You must place your Queen this turn.");
        clearSelection();
        // auto-select queen
        const queenBtn = [...document.querySelectorAll(".invBtn")].find(x=>x.dataset.pt==="Q");
        if(queenBtn) queenBtn.click();
        return;
      }
      if(mustPlaceQueenNow(state, WHITE) && pt==="Q"){
        toast("Queen required this turn.");
      }
      draw();
    });

    invGrid.appendChild(btn);
  }
}

// ---------- Board Interaction (pan/zoom/click) ----------
let dragging=false;
let dragStart=null;

canvas.addEventListener("mousedown",(e)=>{
  dragging=true;
  dragStart={x:e.clientX, y:e.clientY, panX:view.panX, panY:view.panY};
});
window.addEventListener("mousemove",(e)=>{
  if(!dragging) return;
  const dx = e.clientX - dragStart.x;
  const dy = e.clientY - dragStart.y;
  view.panX = dragStart.panX + dx;
  view.panY = dragStart.panY + dy;
  draw();
});
window.addEventListener("mouseup",()=> dragging=false);

canvas.addEventListener("wheel",(e)=>{
  e.preventDefault();
  const factor = Math.exp(-e.deltaY*0.0015);
  const prev = view.scale;
  view.scale = Math.max(28, Math.min(90, view.scale*factor));
  // keep view stable-ish
  const k = view.scale/prev;
  view.panX *= k;
  view.panY *= k;
  draw();
},{passive:false});

canvas.addEventListener("click",(e)=>{
  if(dragging) return;
  if(state.turn!==WHITE) return;
  const rect = canvas.getBoundingClientRect();
  const x=e.clientX-rect.left;
  const y=e.clientY-rect.top;
  const hex = pixelToAxial(x,y);

  handleBoardClick(hex);
});

function handleBoardClick(hex){
  const [q,r]=hex;

  // If click is on a highlighted target, execute
  if(selection.legalTargets.some(t=> t[0]===q && t[1]===r)){
    if(selection.mode==="place"){
      const pt = selection.invPieceType;
      if(!pt) return;
      const mv = {kind:"place", color:WHITE, pieceType:pt, to:[q,r]};
      const legal = legalMoves(state, WHITE).some(m=> sameMove(m,mv));
      if(!legal){ toast("Illegal placement."); return; }
      applyMove(state,mv);
      clearSelection();
      afterHumanMove();
      return;
    }
    if(selection.mode==="move" && selection.boardFrom){
      const mv = {kind:"move", color:WHITE, from:selection.boardFrom, to:[q,r]};
      const legal = legalMoves(state, WHITE).some(m=> sameMove(m,mv));
      if(!legal){ toast("Illegal move."); return; }
      applyMove(state,mv);
      clearSelection();
      afterHumanMove();
      return;
    }
  }

  // Otherwise, try selecting a piece (for moving)
  const st = stackAt(state,q,r);
  if(st.length){
    const top = st[st.length-1];
    if(top.color!==WHITE){
      toast("That’s not your piece.");
      return;
    }
    if(!canMoveYet(state,WHITE)){
      toast("You can’t move until your Queen is placed.");
      return;
    }
    if(mustPlaceQueenNow(state,WHITE)){
      toast("You must place your Queen this turn.");
      return;
    }

    // compute legal move targets for this piece if it is movable
    // must be top (it is)
    if(!hiveConnectedIfRemoveTop(state,q,r)){
      toast("Pinned by the One Hive rule (would split the hive).");
      return;
    }
    const height = st.length-1;
    const dests = legalDestinationsForPiece(state, {t:top.t,color:WHITE,height}, [q,r]);

    clearSelection();
    selection.mode="move";
    selection.boardFrom=[q,r];
    selection.legalTargets = dests;
    draw();
    return;
  }

  // Click empty: if in placement mode, show placements; else clear selection
  if(selection.mode!=="place"){
    clearSelection();
    draw();
  }
}

function sameMove(a,b){
  if(a.kind!==b.kind) return false;
  if(a.color!==b.color) return false;
  if(a.kind==="place"){
    return a.pieceType===b.pieceType && a.to[0]===b.to[0] && a.to[1]===b.to[1];
  }else{
    return a.from[0]===b.from[0] && a.from[1]===b.from[1] && a.to[0]===b.to[0] && a.to[1]===b.to[1];
  }
}

function afterHumanMove(){
  updateSidebar();
  draw();

  const res = gameResult(state);
  if(res){
    toast(res==="whiteWins" ? "You surrounded the Bot’s Queen!" :
          res==="blackWins" ? "Your Queen is surrounded." : "Both Queens surrounded — draw.");
    updateSidebar();
    draw();
    return;
  }

  // Bot turn
  setTimeout(()=>{
    botStep();
  }, 40);
}

function botStep(){
  if(state.turn!==BLACK) return;
  const res = gameResult(state);
  if(res) return;

  const mv = chooseBotMove(state);
  if(!mv){
    toast("Bot has no legal moves.");
    return;
  }
  applyMove(state,mv);

  updateSidebar();
  draw();

  const r = gameResult(state);
  if(r){
    toast(r==="blackWins" ? "Bot surrounded your Queen." :
          r==="whiteWins" ? "You win!" : "Draw.");
    updateSidebar();
    draw();
  }
}

// ---------- Drawing highlights ----------
function draw(){
  resize();
  ctx.clearRect(0,0,canvas.clientWidth,canvas.clientHeight);

  // Subtle board “ghost hexes” around activity
  const bounds = computeInterestingBounds(state, selection);
  const pad = 4;
  const minQ=bounds.minQ-pad, maxQ=bounds.maxQ+pad;
  const minR=bounds.minR-pad, maxR=bounds.maxR+pad;

  // draw faint grid
  ctx.save();
  ctx.globalAlpha = 0.22;
  for(let r=minR; r<=maxR; r++){
    for(let q=minQ; q<=maxQ; q++){
      const [x,y]=axialToPixel(q,r);
      const pts=hexPolygon(x,y,view.scale*0.92);
      drawHex(pts, "transparent", "rgba(68,176,255,.35)", 1.5);
    }
  }
  ctx.restore();

  // highlights
  if(selection.legalTargets.length){
    for(const [q,r] of selection.legalTargets){
      const [x,y]=axialToPixel(q,r);
      const pts=hexPolygon(x,y,view.scale*0.92);
      const fill = selection.mode==="place" ? "rgba(68,176,255,.12)" : "rgba(82,210,115,.12)";
      const stroke = selection.mode==="place" ? "rgba(68,176,255,.90)" : "rgba(82,210,115,.92)";
      drawHex(pts, fill, stroke, 3);
    }
  }

  // selected from piece
  if(selection.boardFrom){
    const [q,r]=selection.boardFrom;
    const [x,y]=axialToPixel(q,r);
    const pts=hexPolygon(x,y,view.scale*0.92);
    drawHex(pts, "rgba(255,178,77,.10)", "rgba(255,178,77,.95)", 3);
  }

  // pieces
  // Draw ground tiles first; stacking is shown by label; we can draw all equally.
  for(const [kk,stack] of state.board.entries()){
    const [q,r]=parseKey(kk);
    drawTileAt(q,r,stack);
  }

  // queen danger indicators
  drawQueenDanger(WHITE);
  drawQueenDanger(BLACK);
}

function computeInterestingBounds(state, selection){
  let qs=[], rs=[];
  for(const kk of state.board.keys()){
    const [q,r]=parseKey(kk); qs.push(q); rs.push(r);
  }
  for(const [q,r] of selection.legalTargets){
    qs.push(q); rs.push(r);
  }
  if(selection.boardFrom){
    qs.push(selection.boardFrom[0]); rs.push(selection.boardFrom[1]);
  }
  if(qs.length===0){
    return {minQ:-2,maxQ:2,minR:-2,maxR:2};
  }
  return {
    minQ: Math.min(...qs),
    maxQ: Math.max(...qs),
    minR: Math.min(...rs),
    maxR: Math.max(...rs),
  };
}

function drawQueenDanger(color){
  const qp = state.queens[color];
  if(!qp) return;
  const ring = neighbors(qp[0],qp[1]).filter(p=>isOccupied(state,p[0],p[1])).length;
  const [x,y]=axialToPixel(qp[0],qp[1]);
  ctx.save();
  ctx.font="700 12px system-ui, sans-serif";
  ctx.textAlign="center";
  ctx.textBaseline="top";
  const txt = `(${ring}/6)`;
  ctx.fillStyle = ring>=5 ? "rgba(255,77,77,.95)" : "rgba(0,0,0,.55)";
  if(color===BLACK) ctx.fillStyle = ring>=5 ? "rgba(255,77,77,.95)" : "rgba(255,255,255,.70)";
  ctx.fillText(txt, x, y+view.scale*0.70);
  ctx.restore();
}

// ---------- Buttons ----------
document.getElementById("resetBtn").addEventListener("click", ()=>{
  state = makeInitialState();
  clearSelection();
  updateSidebar();
  toast("New game.");
  draw();
});
document.getElementById("undoBtn").addEventListener("click", ()=>{
  // Undo last full round if possible: undo bot ply then human ply
  if(state.moveHistory.length===0) return;
  // If it's bot turn, last move was human; undo one ply. If it's your turn, last move was bot; undo two plies if possible.
  if(state.turn===WHITE){
    // undo bot
    undoLastPly(state);
    // undo human if exists
    undoLastPly(state);
  }else{
    // bot thinking -> undo human
    undoLastPly(state);
  }
  clearSelection();
  updateSidebar();
  toast("Undone.");
  draw();
});

// ---------- Start ----------
updateSidebar();
draw();

// Optional: bot can start (set to BLACK) by flipping state.turn, but keeping standard: player starts.
</script>
